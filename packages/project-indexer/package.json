{
  "name": "@afrodite/project-indexer",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "afrodite-index-solid": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@afrodite/protocol": "workspace:*",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "solid-js": "^1.9.7",
    "vitest": "^3.2.4"
  }
}
