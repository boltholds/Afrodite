    "@afrodite/import-core": "workspace:*",
    "@afrodite/motion-core": "workspace:*",
    "@afrodite/protocol": "workspace:*",
    "@afrodite/semantic-ops": "workspace:*",
    "@afrodite/style-core": "workspace:*",
    "@afrodite/ui-ir": "workspace:*",
    "@afrodite/variants-core": "workspace:*",
    "@afrodite/verified-write": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
