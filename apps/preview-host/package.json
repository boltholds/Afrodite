{
  "name": "@afrodite/preview-host",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4174 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@afrodite/adapter-react": "workspace:*",
    "@afrodite/adapter-solid": "workspace:*",
    "@afrodite/canvas-engine": "workspace:*",
    "@afrodite/protocol": "workspace:*",
    "@afrodite/ui-ir": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "solid-js": "^1.9.7"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-solid": "^2.11.8",
    "vitest": "^3.2.4"
  }
}
