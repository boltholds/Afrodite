{
  "name": "@afrodite/studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4173 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@afrodite/adapter-react": "workspace:*",
    "@afrodite/adapter-solid": "workspace:*",
    "@afrodite/canvas-engine": "workspace:*",
    "@afrodite/project-session": "workspace:*",
    "@afrodite/protocol": "workspace:*",
    "@afrodite/semantic-ops": "workspace:*",
    "@afrodite/ui-ir": "workspace:*",
    "@afrodite/variants-core": "workspace:*",
    "solid-js": "^1.9.7"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-solid": "^2.11.8",
    "vitest": "^3.2.4"
  }
