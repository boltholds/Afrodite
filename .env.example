# Bind-mounted source repository that Afrodite may inspect and edit.
# Docker Desktop on Windows accepts forward-slash paths.
AFRODITE_TARGET_PROJECT=C:/Users/bolthold/Documents/Code/Gefest-CAD

# Package directory used for target dependency installation, verification, and live preview.
# Keep `.` for a single-package repository; Gefest CAD keeps its Next.js app in frontend.
AFRODITE_TARGET_PACKAGE_DIR=frontend
AFRODITE_TARGET_PREVIEW_SCRIPT=dev

# Shared local bridge secret. Generate a fresh value, for example in PowerShell:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
AFRODITE_BRIDGE_TOKEN=replace-with-at-least-32-random-characters

# auto installs target dependencies into the persistent package node_modules volume.
# Set off only when the target project does not need package-script verification.
AFRODITE_TARGET_INSTALL=auto
AFRODITE_AGENT_ACTOR=chatgpt-tunnel

# Host ports selected to avoid the currently running Docker Desktop stack.
AFRODITE_TARGET_PREVIEW_PORT=3000
AFRODITE_STUDIO_PORT=4173
AFRODITE_PREVIEW_PORT=4174
AFRODITE_BRIDGE_PORT=4175
AFRODITE_MCP_PORT=8770
AFRODITE_TUNNEL_HEALTH_PORT=8083

# OpenAI tunnel settings.
TUNNEL_ID=tunnel_replace_me
CONTROL_PLANE_API_KEY=sk-proj-replace-me
TUNNEL_PROFILE=afrodite-mcp
TUNNEL_CLIENT_VERSION=0.0.10
